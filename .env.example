APP_NAME="NADI ASN DPMPTSP Prov. Sulawesi Tengah"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=nadi_asn
DB_USERNAME=nadi_runtime
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict
QUEUE_CONNECTION=database
CACHE_STORE=database
# Fail-closed: enable only after privacy review and approval of a public release.
NADI_PUBLIC_RELEASE_ENABLED=false
NADI_PRODUCTION_READY=false
NADI_IMPORT_RETENTION_DAYS=14
NADI_TOTP_KEY=
NADI_TRUSTED_PROXIES=
# Mandatory for production; unavailable scanner rejects uploads.
NADI_UPLOAD_SCAN_ENABLED=false
CLAMAV_HOST=antivirus
CLAMAV_PORT=3310

# Recovery delivery: fill locally, then enable. Never commit SMTP credentials.
NADI_FRONTEND_URL=http://127.0.0.1:5173
NADI_RECOVERY_MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Optional one-time recovery provisioning for an existing Super Admin during migration.
NADI_INITIAL_RECOVERY_NIP=
NADI_INITIAL_RECOVERY_EMAIL=
